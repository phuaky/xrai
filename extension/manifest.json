{
  "manifest_version": 3,
  "name": "rai — local AI feed filter",
  "version": "2.0.0",
  "description": "Local AI feed filter. On X: signal stays, noise disappears. On YouTube: only music + motivational videos show, the rest blurs.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://pbs.twimg.com/*",
    "http://localhost:11434/*",
    "http://localhost:11435/*",
    "https://api.snratio.xyz/*"
  ],
  "background": {
    "service_worker": "background/worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "lib/memory.js",
        "lib/config.js",
        "content/core/classifier.js",
        "content/core/image-classifier.js",
        "content/core/hider.js",
        "content/core/indicator.js",
        "content/core/dwell.js",
        "content/core/hopnudge.js",
        "content/x/prefilter.js",
        "content/x/replyroute.js",
        "content/x/tips.js",
        "content/x/detector.js",
        "content/x/main.js"
      ],
      "css": ["content/core/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "lib/memory.js",
        "lib/config.js",
        "content/core/classifier.js",
        "content/core/image-classifier.js",
        "content/core/hider.js",
        "content/core/indicator.js",
        "content/core/hopnudge.js",
        "content/youtube/prefilter.js",
        "content/youtube/detector.js",
        "content/youtube/shorts.js",
        "content/youtube/watch.js",
        "content/youtube/main.js"
      ],
      "css": ["content/core/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
